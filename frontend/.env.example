# =============================================================================
# MedVerify Frontend Environment Configuration Example
# =============================================================================

# API Gateway / Backend Base URL
# - Development: Leave empty to automatically use Vite reverse proxy (recommmended, avoids CORS issues)
# - Development (Direct): http://127.0.0.1:8001
# - Production: https://api.yourdomain.com (Must be HTTPS in production; do not use localhost)
VITE_API_URL=

# Supabase Authentication & Storage (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
