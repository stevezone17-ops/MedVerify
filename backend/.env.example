# =============================================================================
# MedVerify Backend Environment Configuration Example
# =============================================================================

# Database Provider Selection (supabase | mongodb)
DATABASE_BACKEND=mongodb

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=medicine_verification

# Supabase Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-keep-private
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Application Security & JWT
JWT_SECRET=replace_with_a_secure_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Frontend URL & CORS Origins (Comma-separated)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Configuration (Backend Only — Never expose to client)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2500
GEMINI_TIMEOUT_SECONDS=35.0
GEMINI_RATE_LIMIT_PER_MINUTE=40
GEMINI_ADMIN_RATE_LIMIT_PER_MINUTE=60

# OpenAI LLM Configuration (Backend Only — Optional Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_TIMEOUT_SECONDS=30.0
