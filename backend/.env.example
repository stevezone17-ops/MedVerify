# MedVerify Backend Environment Configuration

# Database Provider Selection (supabase | mongodb)
DATABASE_BACKEND=supabase

# Supabase Production Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-keep-private

# Supabase JWT Secret (Optional: for verifying Supabase Auth JWTs locally)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Legacy / Fallback MongoDB Configuration (Required for migration utility)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=medicine_verification

# Application Security & CORS
JWT_SECRET=replace_with_a_secure_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
FRONTEND_URL=http://localhost:5173

# OpenAI LLM Configuration (Backend Only — Never expose to frontend/client)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_SECONDS=
